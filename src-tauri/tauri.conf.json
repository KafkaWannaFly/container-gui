{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Container GUI",
  "version": "0.6.0",
  "identifier": "com.containergui.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Container GUI",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-lcd-text"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QkQ3M0EyRTMyMDJENDUKUldSRkxTRGpvbk85ZHE5THZ0VXBEV0lWWk5qOXIxeXNUL3FQU0ZFdmJuVEUwRVZGaTkyeWljaFIK",
      "endpoints": ["https://github.com/KafkaWannaFly/container-gui/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
