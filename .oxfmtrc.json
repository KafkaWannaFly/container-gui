{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 110,
  "endOfLine": "lf",
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "*",
    "!src",
    "!src/**",
    "!vite.config.ts",
    "!tsconfig.json",
    "!tsconfig.node.json"
  ]
}
